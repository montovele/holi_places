{
  "name": "holi-places",
  "private": true,
  "workspaces": [
    "holi_frontend",
    "holi_backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @holi-places/backend",
    "dev:web": "npm run dev --workspace @holi-places/frontend",
    "build": "npm run build --workspace @holi-places/frontend",
    "test": "npm run test --workspace @holi-places/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}